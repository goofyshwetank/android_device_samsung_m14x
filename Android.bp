        "android.hardware.media.bufferpool@2.0",
        "libcodec2_vndk",
        "libhidlbase",
        "libutils",
    ],
    header_libs: [
        "libcodec2_headers",
        "libhardware_headers",
    ],
    compile_multilib: "64",
    vendor: true,
}
