soong_namespace {
}

cc_library_shared {
    name: "libsensorndkbridge_shim",
    srcs: ["shims/libsensorndkbridge/ALooper.cpp"],
    shared_libs: [
        "libsensorndkbridge",
        "libutils",
    ],
    header_libs: ["libbase_headers"],
    include_dirs: ["frameworks/hardware/interfaces/sensorservice/libsensorndkbridge"],
    vendor: true,
}

cc_library_shared {
    name: "libsec-ril",
    srcs: [
        "shims/libsec-ril/SmscAddress.cpp",
        "shims/libsec-ril/libsec_ril_smsc_shim.cpp",
    ],
    shared_libs: [
        "libbinder_ndk",
        "libcutils",
        "libdl",
        "liblog",
    ],
    include_dirs: ["hardware/ril/include"],
    cflags: [
        "-Wall",
        "-Werror",
        "-DANDROID_MULTI_SIM",
        "-DANDROID_SIM_COUNT_2",
        "-DRIL_SHLIB",
    ],
    compile_multilib: "64",
    vendor: true,
}

cc_binary {
    name: "sehradio",
    srcs: ["sehradio/sehradio.cpp"],
    init_rc: ["sehradio/sehradio.rc"],
    shared_libs: [
        "libbinder_ndk",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    vendor: true,
}

cc_library_shared {
    name: "libsecc2_shim",
    srcs: ["shims/libsecc2/C2PooledBlockPool.cpp"],
    shared_libs: [
        "android.hardware.media.bufferpool@2.0",
        "libcodec2_vndk",
        "libhidlbase",
        "libutils",
    ],
    header_libs: [
        "libcodec2_headers",
        "libhardware_headers",
    ],
    compile_multilib: "64",
    vendor: true,
}
