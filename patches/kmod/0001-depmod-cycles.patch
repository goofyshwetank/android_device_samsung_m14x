From 7b21fb3ac56a72482b2cd71a8101a3f447d1089a Mon Sep 17 00:00:00 2001
From: goofyshwetank <raiishu989@gmail.com>
Date: Sun, 4 Oct 2026 07:19:32 +0000
Subject: [PATCH] depmod: still write modules.dep when modules cycle

kmod 32 treats the exynos_thermal_v2 <-> gpu_cooling cycle as fatal and
exits before writing modules.dep, so the m14x kernel image never builds.
Log the cycle, drop edges into cyclic modules, and emit the dep files.

Change-Id: I2daf430c552185d134f31a0864631f26d94ddb24
---
 tools/depmod.c | 36 ++++++++++++++++++++++++++++++++++--
 1 file changed, 34 insertions(+), 2 deletions(-)

diff --git a/tools/depmod.c b/tools/depmod.c
index 43fc354..293ea7c 100644
--- a/tools/depmod.c
+++ b/tools/depmod.c
@@ -1995,9 +1995,41 @@ static int depmod_calculate_dependencies(struct depmod *depmod)
 	}
 
 	if (n_sorted < n_mods) {
+		uint8_t *cyclic;
+		struct mod **mods;
+
 		depmod_report_cycles(depmod, n_mods, users);
-		ret = -EINVAL;
-		goto exit;
+		/*
+		 * kmod refuses to write modules.dep on a cycle. Samsung ships
+		 * exynos_thermal_v2 <-> gpu_cooling plus self-loops. Drop edges
+		 * into cyclic modules so the dep walk stays finite and the file
+		 * is written. ponytail: modprobe will not auto-load across a
+		 * dropped edge; modules.load still lists both. Break the cycle
+		 * in the modules if boot order actually depends on that edge.
+		 */
+		cyclic = calloc(n_mods, 1);
+		if (cyclic == NULL) {
+			ret = -ENOMEM;
+			goto exit;
+		}
+		for (i = 0; i < n_mods; i++)
+			cyclic[i] = 1;
+		for (i = 0; i < n_sorted; i++)
+			cyclic[sorted[i]] = 0;
+		mods = (struct mod **)depmod->modules.array;
+		for (i = 0; i < n_mods; i++) {
+			struct mod *m = mods[i];
+			struct mod **arr = (struct mod **)m->deps.array;
+			size_t d, w = 0;
+
+			for (d = 0; d < m->deps.count; d++) {
+				if (cyclic[arr[d]->idx])
+					continue;
+				arr[w++] = arr[d];
+			}
+			m->deps.count = w;
+		}
+		free(cyclic);
 	}
 
 	depmod_sort_dependencies(depmod);
-- 
2.43.0

