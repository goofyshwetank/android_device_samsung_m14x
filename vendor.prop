## Bluetooth
bluetooth.device.default_name=Galaxy F14 5G

## NFC
ro.vendor.nfc.feature.chipname=NXP_SN100U
ro.vendor.nfc.support.advancedsetting=false
ro.vendor.nfc.support.autoselect=true
ro.vendor.nfc.support.defaultaid=true
ro.vendor.nfc.support.nonaid=true
ro.vendor.nfc.support.othercategory=true
ro.vendor.nfc.support.uicc=true
ro.camera.notify_nfc=1
ro.vendor.nfc.support.ese=false
ro.vendor.nfc.info.antpos=2
ro.vendor.nfc.info.antposX=27.2
ro.vendor.nfc.info.antposY=30
ro.vendor.nfc.info.deviceWidth=77.2
ro.vendor.nfc.info.deviceHeight=166.8
ro.vendor.nfc.info.deviceFoldable=false

# F14 radio. 26 is stock NR/LTE/GSM/WCDMA. The common prop file ships 9.
ro.radio.noril=no
ro.carrier=unknown
ro.telephony.default_cdma_sub=0
ro.telephony.default_network=26
ro.vendor.epdg.support=true
ro.vendor.sec.radio.def_network=26
