<!-- These resources are around just to allow their values to be customized -->
<resources>
    <!-- Adjust the icon padding in status bar for rounded corners -->
    <dimen name="rounded_corner_content_padding">20px</dimen>

    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">12dp</dimen>

    <!--
      Mali-G68 MP2, 1080x2408 @ 90 Hz, lcd_density 450.
      KawaseDualFilterV2 adds a pass per 10px (ceil(radius_px * 0.1), max 3).
      Framework 34dp is ~96px, so the shade always takes the 3-pass path and
      drops frames. 3dp is ~8px: one pass, blur still on. Settings toggle stays.
      ponytail: ceiling is radius_px <= 10. Raise past 3dp only if density drops.
    -->
    <dimen name="max_shade_window_blur_radius">3dp</dimen>
    <dimen name="global_actions_blur_radius">3dp</dimen>
    <dimen name="bottomsheet_blur_radius">3dp</dimen>
    <dimen name="volume_dialog_background_surface_blur_radius">3dp</dimen>
    <dimen name="dream_overlay_anim_blur_radius">3dp</dimen>
    <dimen name="notification_background_blur_radius">3dp</dimen>
    <dimen name="keyguard_shortcuts_blur_radius">3dp</dimen>
</resources>
